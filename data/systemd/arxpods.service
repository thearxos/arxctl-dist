[Unit]
Description=ArxOS Bluetooth audio notifications (AirPods pill + generic headphones)
# a graphical-session user service: it shows the pill and plays chimes, so it needs the desktop.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/arxpods run
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
