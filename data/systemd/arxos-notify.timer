[Unit]
Description=Check for ArxOS updates periodically (worldwide ping)
# Enabled for every account's user manager, which includes system accounts such as the login
# screen's (lightdm): only people's accounts run it.
ConditionUser=!@system

[Timer]
OnStartupSec=2min
OnUnitActiveSec=90min
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
