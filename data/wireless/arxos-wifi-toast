#!/bin/bash
# Called by the udev rule when a wireless-arsenal adapter is plugged in. udev runs us as root with no
# display and REAPS any process still alive when the event finishes, so the toast must be launched in
# a transient unit that outlives the event. systemd-run --no-block does exactly that; targeting the
# active session's uid with its DISPLAY/XDG_RUNTIME_DIR lets the GUI reach the desktop.
# Silent and best-effort: no active session, an unknown adapter, or missing tools all just do nothing.
ID="${1:-${ID_VENDOR_ID:-}:${ID_MODEL_ID:-}}"
[ "${#ID}" = 9 ] || exit 0
command -v arxpods >/dev/null 2>&1 || exit 0
command -v systemd-run >/dev/null 2>&1 || exit 0

# First make the adapter usable, as root and before any session check: unblock its radio and bring
# the link up. Its interface appears a moment after the USB device, so the helper waits for it in a
# transient unit of its own (udev would reap a process that outlives this event).
command -v arxos-wifi-ctl >/dev/null 2>&1 && \
  systemd-run --no-block --quiet --unit="arxos-wifi-ensure-${ID/:/-}-$$" arxos-wifi-ctl ensure-usb "$ID" 2>/dev/null

# the active graphical session's user
user=""
for u in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $3}' | sort -u); do
  [ "$(loginctl show-user "$u" -p State --value 2>/dev/null)" = active ] && { user="$u"; break; }
done
[ -n "$user" ] || exit 0
uid="$(id -u "$user" 2>/dev/null)" || exit 0
[ -S "/run/user/$uid/bus" ] || [ -d "/run/user/$uid" ] || exit 0

# The session's X display and its authority file, read from one of the user's own desktop
# processes. Without the cookie the X server refuses the window ("Authorization required, but
# no authorization protocol specified", then "Failed to open display"), so the toast never
# appeared from udev although it worked when started from a terminal (2026-11-02).
disp=""; xauth=""
for pid in $(pgrep -u "$uid" 2>/dev/null); do
  env_file="/proc/$pid/environ"
  [ -r "$env_file" ] || continue
  d="$(tr '\0' '\n' < "$env_file" 2>/dev/null | sed -n 's/^DISPLAY=//p' | head -n1)"
  [ -n "$d" ] || continue
  disp="$d"
  xauth="$(tr '\0' '\n' < "$env_file" 2>/dev/null | sed -n 's/^XAUTHORITY=//p' | head -n1)"
  break
done
[ -n "$disp" ] || disp=":0"
if [ -z "$xauth" ]; then
  home="$(getent passwd "$user" | cut -d: -f6)"
  xauth="$home/.Xauthority"
fi

# a transient scope, run as the session user, detached from the udev event so it is not reaped
systemd-run --no-block --quiet \
  --uid="$uid" \
  --setenv=DISPLAY="$disp" \
  --setenv=XAUTHORITY="$xauth" \
  --setenv=XDG_RUNTIME_DIR="/run/user/$uid" \
  --setenv=DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
  arxpods wifi-toast "$ID" 2>/dev/null
exit 0
