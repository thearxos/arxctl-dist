# ArxOS wireless arsenal: show a toast when a monitor-mode / injection-capable USB WiFi
# adapter is connected. One rule per known chipset id; the dispatcher resolves the active
# session and shows the arxpods router toast with the chipset and all its drivers.
# Generated from arsenal-adapters.json; keep them in step.

ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0bda", ATTR{idProduct}=="0811", RUN+="/usr/local/bin/arxos-wifi-toast 0bda:0811"
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0bda", ATTR{idProduct}=="8178", RUN+="/usr/local/bin/arxos-wifi-toast 0bda:8178"
